# Copie este archivo a .env y ajuste los valores antes de
# `docker compose up -d` (o de correr localmente sin Docker). .env
# nunca se versiona (ver .gitignore/.dockerignore).
#
# Cada variable de abajo esta clasificada segun quien la consume
# realmente (confirmado por inspeccion de
# src/altamira_extractor/config.py y docker-compose.yml, Prompt 14a.1):
# Settings (con o sin prefijo ALTAMIRA_), Docker Compose, o ambos.

# ---------------------------------------------------------------------
# Neo4j: consumidas por Settings (validation_alias sin prefijo ALTAMIRA_,
# ver config.py) Y por docker-compose.yml (NEO4J_AUTH del servicio
# neo4j). NEO4J_URI debe seguir apuntando al nombre del servicio Compose
# (bolt://neo4j:7687), no a localhost, para que el contenedor app
# alcance al contenedor neo4j por la red interna.
# ---------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# Reemplace este password: minimo 8 caracteres (la imagen oficial de
# Neo4j rechaza contrasenas mas cortas al arrancar). NO apto para
# produccion tal cual viene aqui -- es unicamente un valor de ejemplo
# para levantar el stack por primera vez.
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------
# Unicamente Docker Compose (docker-compose.yml: "${NEO4J_IMAGE:-...}").
# Compose ya tiene un default seguro si se omite esta variable.
# ---------------------------------------------------------------------
NEO4J_IMAGE=neo4j:5-community

# ---------------------------------------------------------------------
# Settings, prefijo ALTAMIRA_ (src/altamira_extractor/config.py).
# Todas tienen default razonable: solo hace falta descomentar/ajustar lo
# que realmente se quiera cambiar.
# ---------------------------------------------------------------------

# Concurrencia del executor local de la API (api/executor.py): cuantas
# ejecuciones de run_ingestion pueden estar activas a la vez EN ESTE
# PROCESO. V1 requiere un unico worker de Uvicorn (ver Dockerfile/
# api/app.py) -- subir este numero no aumenta paralelismo real entre
# procesos, solo cuantos runs concurrentes acepta el unico proceso.
ALTAMIRA_API_MAX_WORKERS=1

# Timeouts/limites de conexion y carga a Neo4j (pipeline/neo4j_repository.py)
ALTAMIRA_NEO4J_CONNECTION_TIMEOUT_SECONDS=30
ALTAMIRA_NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=30
ALTAMIRA_NEO4J_LOAD_BATCH_SIZE=500

# Limites de PackageValidator/SafeExtractor (etapas RECEIVED/VALIDATED/EXTRACTED)
ALTAMIRA_MAX_PACKAGE_SIZE_BYTES=209715200
ALTAMIRA_MAX_ENTRY_COUNT=5000
ALTAMIRA_MAX_SINGLE_ENTRY_UNCOMPRESSED_BYTES=52428800
ALTAMIRA_MAX_TOTAL_UNCOMPRESSED_BYTES=1073741824
ALTAMIRA_MAX_COMPRESSION_RATIO=100.0

# Profundidad de DATA_DEPENDS_ON/CONTROL_DEPENDS_ON y limites de
# CONTEXTS_BUILT (pipeline/context_package_builder.py)
ALTAMIRA_DEPENDENCY_DEPTH=4
ALTAMIRA_MAX_CODE_SLICE_PARAGRAPHS=200
ALTAMIRA_MAX_TRANSACTIONAL_TABLES=100
ALTAMIRA_MAX_PARAMETER_ENTRIES_PER_CONTEXT=1000

# ---------------------------------------------------------------------
# Cliente LLM OpenAI-compatible (Settings, validation_alias sin prefijo
# ALTAMIRA_ -- src/altamira_extractor/config.py;
# src/altamira_extractor/pipeline/llm_client.py). Ninguna de estas es
# obligatoria para construir Settings ni para correr las etapas
# deterministicas (RECEIVED..CONTEXTS_BUILT): la validacion real ocurre
# recien al resolver el perfil del proveedor (resolve_llm_profile),
# invocado por RULE_DRAFTS_GENERATED. Puede dejar LLM_PROVIDER y las
# credenciales sin configurar hasta llegar a esa etapa.
#
# LLM_TEMPERATURE debe permanecer en 0 (CLAUDE.md: "Temperatura 0",
# determinismo): cualquier otro valor hace fallar la construccion de
# Settings a proposito. No la elimine ni la cambie.
# ---------------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_HTTP_RETRIES=3
LLM_REPAIR_ATTEMPTS=2

# Descomente y complete UNICAMENTE el proveedor que vaya a usar.
# Placeholders inequivocos a proposito: dejarlos comentados evita
# configurar por error una credencial invalida como si fuera real.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-REPLACE-WITH-REAL-KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=REPLACE-WITH-APPROVED-MODEL

# LLM_PROVIDER=pwc_gateway
# PWC_GENAI_API_KEY=REPLACE-WITH-REAL-KEY
# PWC_GENAI_BASE_URL=https://REPLACE-WITH-GATEWAY-BASE
# PWC_GENAI_MODEL=openai.gpt-4o-2024-11-20
