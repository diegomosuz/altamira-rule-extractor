APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=/app/data

NEO4J_IMAGE=neo4j:5-community
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# Configuracion de carga/validacion del grafo (src/altamira_extractor/config.py, Settings)
ALTAMIRA_NEO4J_CONNECTION_TIMEOUT_SECONDS=30
ALTAMIRA_NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=30
ALTAMIRA_NEO4J_LOAD_BATCH_SIZE=500

MAX_ZIP_SIZE_BYTES=2147483648
MAX_UNCOMPRESSED_SIZE_BYTES=10737418240
MAX_ZIP_FILES=50000
MAX_EXPANSION_RATIO=100

# Limites de PackageValidator/SafeExtractor (src/altamira_extractor/config.py, Settings)
ALTAMIRA_MAX_PACKAGE_SIZE_BYTES=209715200
ALTAMIRA_MAX_ENTRY_COUNT=5000
ALTAMIRA_MAX_SINGLE_ENTRY_UNCOMPRESSED_BYTES=52428800
ALTAMIRA_MAX_TOTAL_UNCOMPRESSED_BYTES=1073741824
ALTAMIRA_MAX_COMPRESSION_RATIO=100.0

CODE_SLICE_MAX_DEPTH=4
PIPELINE_MAX_CONCURRENCY=1

# Limites de CONTEXTS_BUILT (src/altamira_extractor/config.py, Settings)
ALTAMIRA_DEPENDENCY_DEPTH=4
ALTAMIRA_MAX_CODE_SLICE_PARAGRAPHS=200
ALTAMIRA_MAX_TRANSACTIONAL_TABLES=100
ALTAMIRA_MAX_PARAMETER_ENTRIES_PER_CONTEXT=1000

LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=120
LLM_HTTP_RETRIES=3
LLM_REPAIR_ATTEMPTS=2
LLM_TEMPERATURE=0

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-approved-model

PWC_GENAI_API_KEY=replace-me
PWC_GENAI_BASE_URL=https://replace-with-gateway-base
PWC_GENAI_MODEL=openai.gpt-4o-2024-11-20
