{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/rule-draft.schema.json",
  "title": "RuleDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "context",
    "statement",
    "condition",
    "parameters",
    "effect",
    "parameter_source",
    "traceability",
    "limitations",
    "claims",
    "evidence_validation_status",
    "functional_review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect": {
      "type": "string",
      "minLength": 1
    },
    "parameter_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "field",
          "evidence_paths",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "title",
              "context",
              "statement",
              "condition",
              "parameters",
              "effect",
              "parameter_source",
              "traceability",
              "limitations"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^\\$\\."
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence_validation_status": {
      "enum": [
        "PENDING",
        "EVIDENCE_VALIDATED",
        "REJECTED"
      ]
    },
    "functional_review_status": {
      "const": "NEEDS_FUNCTIONAL_REVIEW"
    }
  }
}
