{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(python -m ruff *)",
      "Bash(python -m mypy *)",
      "Bash(pytest *)",
      "Bash(mvn *)",
      "Bash(docker compose config)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Write(./.env.example)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(docker compose exec *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./secrets/**)",
      "Read(./data/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)"
    ]
  }
}
